# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Shell scripts
*.sh text eol=lf

# Config files
.gitignore text eol=lf
.gitattributes text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
nginx.conf text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

