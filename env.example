# =====================================================
# RADIUS Multi-Tenant Admin Panel - Environment Variables
# =====================================================
# Copy this file to .env and update the values

# =====================================================
# MySQL Database Configuration
# =====================================================
MYSQL_ROOT_PASSWORD=your_secure_password_here
MYSQL_DATABASE=radius
MYSQL_ROOT_HOST=%

# =====================================================
# Backend Configuration
# =====================================================
NODE_ENV=production
PORT=3000

# Database Connection
DB_HOST=mysql
DB_PORT=3306
DB_NAME=radius
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Redis Connection
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# =====================================================
# Security Notes
# =====================================================
# 1. Change all passwords before production deployment
# 2. Generate strong JWT secret: openssl rand -base64 32
# 3. Use strong MySQL password: openssl rand -base64 24
# 4. Update CORS_ORIGIN to your production domain
# 5. Never commit .env file to git (it's in .gitignore)

